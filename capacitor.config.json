{
  "appId": "app.bharris.cram",
  "appName": "bharris.app",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "backgroundColor": "#f8fafc",
  "server": {
    "iosScheme": "https",
    "hostname": "bharris-app.web.app",
    "allowNavigation": [
      "bharris-app.firebaseapp.com",
      "accounts.google.com",
      "*.google.com",
      "*.googleusercontent.com",
      "*.gstatic.com"
    ]
  },
  "ios": {
    "contentInset": "never",
    "preferredContentMode": "mobile",
    "backgroundColor": "#f8fafc"
  },
  "plugins": {
    "FirebaseAuthentication": {
      "skipNativeAuth": true,
      "providers": ["apple.com", "google.com"]
    }
  }
}
