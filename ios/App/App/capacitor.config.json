{
	"appId": "app.lastminutestudy.cram",
	"appName": "Last Minute Study",
	"webDir": "dist",
	"bundledWebRuntime": false,
	"backgroundColor": "#f8fafc",
	"server": {
		"iosScheme": "https",
		"hostname": "enthusiastic-cram-genius-flow.base44.app"
	},
	"ios": {
		"contentInset": "never",
		"preferredContentMode": "mobile",
		"backgroundColor": "#f8fafc"
	},
	"plugins": {
		"FirebaseAuthentication": {
			"skipNativeAuth": true,
			"providers": [
				"apple.com",
				"google.com"
			]
		}
	},
	"packageClassList": [
		"FirebaseAuthenticationPlugin",
		"PurchasesPlugin"
	]
}
