{
	"appId": "com.brodregoss.lastminutestudy",
	"appName": "Last Minute Study",
	"webDir": "dist",
	"ios": {
		"contentInset": "never",
		"backgroundColor": "#0f172a",
		"preferredContentMode": "mobile",
		"scheme": "Last Minute Study",
		"limitsNavigationsToAppBoundDomains": false
	},
	"plugins": {
		"CapacitorHttp": {
			"enabled": true
		},
		"SplashScreen": {
			"launchShowDuration": 1200,
			"launchAutoHide": true,
			"backgroundColor": "#0f172a",
			"showSpinner": false,
			"splashFullScreen": true,
			"splashImmersive": true
		},
		"StatusBar": {
			"style": "DARK",
			"backgroundColor": "#ffffff"
		},
		"Keyboard": {
			"resize": "body",
			"resizeOnFullScreen": true
		}
	},
	"packageClassList": [
		"AppPlugin",
		"KeyboardPlugin",
		"SplashScreenPlugin",
		"StatusBarPlugin"
	]
}
