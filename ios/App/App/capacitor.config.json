{
	"appId": "app.bharris.cram",
	"appName": "bharris.app",
	"webDir": "dist",
	"bundledWebRuntime": false,
	"backgroundColor": "#000000",
	"server": {
		"iosScheme": "https",
		"hostname": "bharris-app.web.app",
		"allowNavigation": [
			"bharris-app.firebaseapp.com",
			"accounts.google.com",
			"*.google.com",
			"*.googleusercontent.com",
			"*.gstatic.com"
		]
	},
	"ios": {
		"contentInset": "never",
		"preferredContentMode": "mobile",
		"backgroundColor": "#000000"
	},
	"plugins": {
		"FirebaseAuthentication": {
			"skipNativeAuth": true,
			"providers": [
				"apple.com",
				"google.com"
			]
		}
	},
	"packageClassList": [
		"FirebaseAuthenticationPlugin",
		"CAPBrowserPlugin",
		"LocalNotificationsPlugin",
		"PurchasesPlugin"
	]
}
