# Used by Xcode script phases to find Node.
# Override locally with `.xcode.env.local` (not committed).

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"

export PATH="/usr/local/bin:/opt/homebrew/bin:$HOME/.fnm:$PATH"

if [ -z "${NODE_BINARY:-}" ] || [ ! -x "${NODE_BINARY:-}" ]; then
  export NODE_BINARY="$(command -v node || true)"
fi
