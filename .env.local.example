# Copy to .env.local for local `npm run dev` if you want to override production.
# iOS / TestFlight builds already use .env.production (the hosted Base44 app).
# .env.local is gitignored — never commit real secrets here.

VITE_BASE44_APP_ID=your_app_id
VITE_BASE44_APP_BASE_URL=https://your-app.base44.app
