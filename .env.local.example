# Copy to .env.local. Never commit real values.

# Server-only OpenAI key for `npm run dev` and for Vercel.
# Do NOT prefix this with VITE_ — that would bake it into the iPhone app.
OPENAI_API_KEY=

# After you deploy to Vercel, paste the API URL here, then run `npm run ios:sync`.
# Example: https://your-app.vercel.app/api/llm
# This URL is not a secret. The key stays on the server.
VITE_LLM_PROXY_URL=

# Meantime account store. Free Upstash Redis — paste the REST URL + token from the Upstash dashboard.
# Do NOT prefix these with VITE_.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional. Makes this email an admin even if it was not the first account.
ADMIN_EMAIL=
