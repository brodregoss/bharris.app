# Copy to .env.local. Never commit real values.

# Firebase web config (safe to prefix with VITE_ — this is the public client config).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Enable Google in Firebase Authentication → Sign-in method.
# For iPhone, add an iOS app (bundle id app.bharris.cram) and put
# GoogleService-Info.plist in ios/App/App/. Copy REVERSED_CLIENT_ID into Info.plist URL Types.

# Cloudflare Worker origin for the iPhone build. Local `npm run dev` proxies /v1 to wrangler.
# Example: https://bharris.your-subdomain.workers.dev
VITE_WORKER_URL=

# RevenueCat public iOS SDK key (appl_…). Secret keys stay in worker/.dev.vars.
VITE_REVENUECAT_IOS_API_KEY=
VITE_REVENUECAT_ENTITLEMENT_ID=Study Pro

# AdMob iOS ad unit IDs. Leave blank to use Google's test ads.
# Before an App Store build, set these and replace GADApplicationIdentifier in ios/App/App/Info.plist
# with your AdMob app ID (ca-app-pub-xxxxxxxx~yyyyyyyy).
VITE_ADMOB_REWARDED_IOS_ID=
VITE_ADMOB_BANNER_IOS_ID=

# Optional leftover for the old Vercel proxy. New AI calls go to the Worker.
# OPENAI_API_KEY=
